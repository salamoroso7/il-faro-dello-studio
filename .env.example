# Esempio di file .env per il-faro-dello-studio
# Copia questo file in `.env` e personalizza i valori locali. Non committare `.env`.

# URL completo del datasource JDBC
DB_URL=jdbc:mysql://localhost:3306/ilfarodellostudio?serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USER=root
DB_PWD=your_password_here
DB_DRIVER=com.mysql.cj.jdbc.Driver

